# Copy to `.env` to change where the dashboard reads its data from.
# Both settings are optional — the defaults below are what you get without a
# .env file at all.

# `snapshot` reads the committed snapshot.json and needs no backend running.
# `api` reads the live FastAPI endpoints instead.
# You can also override per-visit with ?source=api in the URL.
VITE_DATA_SOURCE=snapshot

# Where the FastAPI backend lives, used when the source is `api`.
VITE_API_BASE_URL=http://localhost:8000
